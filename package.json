{
  "name": "opencode-agent-communicator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check --formatter-enabled=false .",
    "check:conventions": "bun tools/run-conventions.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run check:conventions && bun run typecheck && bun test test/unit test/integration test/black-box",
    "test": "bun test",
    "test:unit": "bun test test/unit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.21",
    "@opencode-ai/sdk": "1.18.21",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  }
}
